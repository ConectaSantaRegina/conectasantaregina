<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Conecta Santa Regina — o guia do nosso bairro</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@700;800&family=Figtree:wght@400;600&display=swap">
<style>
:root{--bg:#f9f4e6;--card:#fff;--ink:#142920;--mut:#5a6e65;--pri:#00765c;--pri-i:#fff;--acc:#fba537;--acc-i:#3e2104;--ln:#e5e7db;--bad:#b3372f;--ok:#00765c;--hd:#fdfaf1;--mint:#c9f4db;--mint-i:#143b2e;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 Figtree,system-ui,sans-serif}
h1,h2,h3{font-family:'Bricolage Grotesque',Georgia,serif;line-height:1.15;letter-spacing:-.02em;margin:0 0 .4em}
h1{font-size:clamp(2rem,5vw,3.2rem);font-weight:800}h2{font-size:1.6rem}
a{color:var(--pri)}:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.w{max-width:1340px;margin:auto;padding:0 16px}section.w{padding-top:28px;padding-bottom:12px}
#top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--hd);color:var(--ink);border-bottom:1px solid var(--ln)}#top a{color:inherit}#top .b.a{color:var(--acc-i)}
.bar{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;justify-content:space-between;padding-top:10px;padding-bottom:6px}
.brand{text-decoration:none;display:flex;align-items:center;gap:10px}.brand div{display:flex;flex-direction:column;line-height:1.2}.brand b{font:800 1.1rem 'Bricolage Grotesque',serif}.brand span{font-size:.8rem;color:var(--mut)}.lg{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--pri);flex:none}
.acc{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
#top nav{display:flex;gap:4px;overflow-x:auto;padding-bottom:8px}#top nav a{white-space:nowrap;padding:6px 12px;border-radius:999px;text-decoration:none;font-size:.92rem;font-weight:600;color:var(--mut)}#top nav a[aria-current]{background:var(--mint);color:var(--mint-i)}
.b{border:0;border-radius:999px;padding:.6em 1.2em;font:600 1rem Figtree,sans-serif;cursor:pointer;background:var(--pri);color:var(--pri-i)}a.b{text-decoration:none;display:inline-block}
.b.s{background:none;color:var(--pri);border:2px solid var(--pri)}.b.a{background:var(--acc);color:#2a1d00}.b.d{background:var(--bad);color:#fff}
.hero{position:relative;color:#fff;padding:90px 0 110px;background:#1a2412 url("data:image/jpeg;base64,") right center/auto 100% no-repeat;overflow:hidden}.hero::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#1a2412 0,#1a2412 35%,rgba(26,36,18,.55) 60%,rgba(26,36,18,0) 85%)}.hero .w{position:relative}.hero h1{max-width:13em;font-size:clamp(2.2rem,6vw,4rem)}.hero p{max-width:56ch;font-size:1.1rem}.bdg{display:inline-block;background:var(--acc);color:var(--acc-i);font:800 1.3rem 'Bricolage Grotesque',serif;padding:10px 20px;border-radius:12px;margin-bottom:18px}@media(max-width:700px){.hero::before{background:rgba(26,36,18,.78)}}
.hd{display:flex;gap:12px;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;margin-bottom:12px}
.g{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}.feed{max-width:100%;margin:auto}
.card{background:var(--card);border:1px solid var(--ln);border-radius:14px;overflow:hidden;margin-bottom:8px}
.pw{display:block;width:100%;padding:0;border:0;background:rgba(0,0,0,.06);cursor:zoom-in}.pic{display:block;margin:auto;max-width:100%;max-height:200px;object-fit:contain}
.cb{padding:8px 10px}.cb h3{font-size:1rem;margin:4px 0 6px}.cb p{margin:4px 0;font-size:.85rem;white-space:pre-line}.mut{color:var(--mut)}
.tile{display:block;padding:16px;background:var(--card);border:1px solid var(--ln);border-left:6px solid var(--acc);border-radius:10px;text-decoration:none;color:var(--ink)}.tile b{display:block;font:700 1.1rem 'Bricolage Grotesque',serif}.tile span{color:var(--mut);font-size:.92rem}
.note{background:color-mix(in srgb,var(--acc) 22%,var(--card));border-radius:10px;padding:10px 14px;margin:12px 0}
.cta{text-align:center;background:var(--card);border-radius:14px;margin-top:24px}
label{display:block;margin:10px 0;font-weight:600}input,textarea,select{display:block;width:100%;margin-top:4px;padding:10px;border:1px solid var(--ln);border-radius:8px;background:var(--bg);color:inherit;font:inherit}
.box,.car{background:var(--card);border:1px solid var(--ln);border-radius:14px;padding:20px}form.box{max-width:560px}
.auth{display:grid;gap:20px;grid-template-columns:1fr 1fr}@media(max-width:760px){.auth{grid-template-columns:1fr}}
.car img{width:100%;object-fit:contain}.car{overflow:visible;display:grid;grid-auto-flow:column;gap:16px;scrollbar-width:none}.dots{display:flex;gap:8px;align-items:center;justify-content:center;margin-top:12px}.dots i{width:9px;height:9px;border-radius:50%;background:var(--ln)}.dots i.on{background:var(--pri)}.dots button{border:0;background:none;font-size:1.7rem;color:var(--pri);cursor:pointer}
.tabs{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap}.tabs button{flex:1;padding:8px 14px;border:2px solid var(--pri);background:none;color:var(--pri);border-radius:999px;font:600 1rem Figtree,sans-serif;cursor:pointer}.tabs [aria-pressed="true"]{background:var(--pri);color:var(--pri-i)}
.row,.row2{background:var(--card);border:1px solid var(--ln);border-radius:12px;padding:12px;margin:12px 0;display:flex;flex-wrap:wrap;gap:10px;align-items:center}.row .card,.row2 .card{flex:1 1 280px;margin:0}.rb{display:flex;flex-direction:column;gap:8px;align-items:flex-start}
.tag{padding:2px 10px;border-radius:999px;font-size:.85rem;font-weight:600}.tag.p{background:var(--acc);color:#2a1d00}.tag.o{background:var(--ok);color:var(--pri-i)}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%}td,th{padding:8px;border-bottom:1px solid var(--ln);text-align:left;font-size:.92rem}
.pwd{position:relative;display:block;margin-top:4px}.pwd input{margin-top:0;padding-right:48px}.eye{position:absolute;right:4px;top:50%;transform:translateY(-50%);width:40px;height:40px;display:grid;place-items:center;border:0;border-radius:8px;background:none;color:var(--mut);cursor:pointer}.eye:hover{color:var(--ink)}.eye .sl{display:none}.eye.on .sl{display:block}
dialog{border:0;border-radius:16px;width:min(560px,94vw);max-height:92vh;background:var(--card);color:var(--ink);padding:0}dialog::backdrop{background:rgba(0,0,0,.6)}.mp{padding:20px}
dialog.z{background:none;width:auto;max-width:96vw;overflow:visible}dialog.z .mp{padding:0}dialog.z img{display:block;max-width:96vw;max-height:92vh;object-fit:contain;cursor:zoom-out}dialog.z::backdrop{background:rgba(0,0,0,.88)}.carousel-wrapper{position:relative;width:100%;background:var(--card);border-radius:14px;overflow:hidden;border:1px solid var(--ln);display:flex;align-items:stretch;height:320px;transition:opacity .15s ease-in-out}.carousel-image-side{flex:0 0 55%;position:relative;overflow:hidden}.carousel-image{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s ease-in-out}.carousel-dots{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:3;background:rgba(0,0,0,.3);padding:8px 12px;border-radius:999px}.dot{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.6);cursor:pointer;transition:all .3s;border:0}.dot.active{background:#fff;width:11px}.carousel-info{flex:1;padding:24px;display:flex;flex-direction:column;justify-content:space-between;background:var(--card);cursor:pointer}.carousel-info h3{margin:0 0 10px;font-size:1.2rem;line-height:1.3;color:var(--ink);overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.carousel-info p{margin:0;font-size:.9rem;color:var(--mut);line-height:1.5;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;flex:1}.carousel-info small{color:var(--mut);display:block;font-size:.85rem}.carousel-nav{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;border-radius:50%;background:rgba(0,0,0,.35);border:0;color:#fff;font-size:1.5rem;cursor:pointer;z-index:3;display:flex;align-items:center;justify-content:center;transition:background .2s}.carousel-nav:hover{background:rgba(0,0,0,.55)}.carousel-nav.prev{left:12px}.carousel-nav.next{right:12px}.category-tag{display:inline-block;background:var(--acc);color:var(--acc-i);font-weight:600;font-size:.8rem;padding:4px 12px;border-radius:6px;margin-bottom:12px;width:fit-content}
.cl{position:fixed;top:12px;right:16px;font-size:2rem;line-height:1;background:rgba(0,0,0,.55);color:#fff;border:0;border-radius:50%;width:44px;height:44px;cursor:pointer}
.qr{display:grid;place-items:center;text-align:center;width:190px;height:190px;margin:12px auto;border:2px dashed var(--ln);border-radius:12px;color:var(--mut)}.qr img{width:100%;height:100%;object-fit:contain}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;z-index:99;max-width:92vw}#toast[hidden]{display:none}
footer{margin-top:40px;padding-top:24px;padding-bottom:24px;color:var(--mut);font-size:.9rem}
</style>
</head>
<body>
<header id="top"></header><main id="app"></main>
<footer class="w"><b>Conecta Santa Regina</b><br>Um espaço feito por moradores, para moradores. Feito com carinho pelo bairro Santa Regina.</footer>
<dialog id="dlg"></dialog><div id="toast" role="status" hidden></div>
<script>
const ADMIN='conectasantaregina@gmail.com',PIX_IMG='',K='csr-demo';
const SL=[{t:'Perfil grátis',x:'Cadastre seu comércio, vagas de emprego e imóveis sem custo. Tudo passa pela aprovação da administração antes de aparecer.'},{t:'Perfil Premium',x:'Publique no Feed e em Novidades. A mensalidade é paga por Pix e o perfil fica ativo até a data combinada.'},{t:'Como virar Premium',x:'Toque em “Quero compartilhar”, preencha o mini cadastro e escolha os meses. A administração chama você no WhatsApp, passa a chave Pix e confirma a ativação.'}];
const NAV=[['','Início'],['comercio','Comércio e Serviços'],['saude','Serviços Públicos'],['empregos','Empregos'],['imoveis','Aluguel e Venda'],['novidades','Novidades'],['melhorias','Melhorias'],['acoes','Doações e Ações'],['contato','Fale Conosco']];
const C={
comercio:{t:'Comércio e Serviços',d:'Mercados, farmácias, restaurantes, bancos, academias e lojas',b:'Cadastrar meu comércio',p:'Endereço e contato'},
saude:{t:'Serviços Públicos',d:'Escolas, postos de saúde, praças, bibliotecas e subprefeitura',b:'Sugerir um serviço',p:'Endereço e horário'},
empregos:{t:'Balcão de Empregos',d:'Vagas oferecidas aqui pertinho',b:'Publicar vaga',p:'Como se candidatar'},
imoveis:{t:'Aluguel e Venda',d:'Casas, quartos, salas e terrenos',b:'Anunciar imóvel',p:'Valor e contato'},
novidades:{t:'Novidades',d:'Promoções, obras, eventos e avisos',b:'Postar novidade',p:'Link ou contato (opcional)',pr:1},
melhorias:{t:'Propor Melhorias',d:'Sugira e apoie ideias para o bairro',b:'Propor melhoria',p:'Local da melhoria'},
acoes:{t:'Doações e Ações',d:'Mutirões, campanhas e solidariedade',b:'Divulgar ação',p:'Contato (WhatsApp - opcional)'},
feed:{t:'Feed da comunidade',b:'Quero compartilhar',p:'Contato (opcional)',pr:1}};
const $=s=>document.querySelector(s),E=s=>String(s??'').replace(/[&<>"']/g,c=>'&#'+c.charCodeAt(0)+';');
let D={u:[],i:[],r:[],m:[],s:null},tab='in',si=0,at='ap',ni=0;
try{D=JSON.parse(localStorage.getItem(K))||D}catch(e){}
const dlg=$('#dlg');
const toast=m=>{const t=$('#toast');t.textContent=m;t.hidden=false;clearTimeout(toast.h);toast.h=setTimeout(()=>t.hidden=true,4000)};
const save=()=>{try{localStorage.setItem(K,JSON.stringify(D))}catch(e){toast('Não foi possível salvar. Tente uma foto menor.')}};
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const me=()=>{const u=D.u.find(x=>x.id===D.s);return u&&!u.bl?u:null};
const isAdm=u=>u?.role==='admin',prem=u=>!!u&&(isAdm(u)||u.ate>Date.now());
const fd=t=>new Date(t).toLocaleDateString('pt-BR');
const pend=()=>D.i.filter(i=>i.st==='p').length+D.r.filter(r=>r.st==='p').length;
const wa=(t,m)=>'https://wa.me/55'+String(t).replace(/\D/g,'')+'?text='+encodeURIComponent(m);
const ok=c=>D.i.filter(i=>i.cat===c&&i.st==='o'&&(!i.exp||i.exp>Date.now())).sort((a,b)=>b.w-a.w);
const go=h=>{location.hash='#/'+h},to=h=>{go(h);view()};
const hs=async s=>[...new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s)))].map(b=>b.toString(16).padStart(2,'0')).join('');
const shrink=f=>new Promise(r=>{if(!f||!f.size)return r('');const im=new Image,u=URL.createObjectURL(f);im.onload=()=>{const k=Math.min(1,1100/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);URL.revokeObjectURL(u);r(c.toDataURL('image/jpeg',.8))};im.onerror=()=>r('');im.src=u});
const modal=(h,z)=>{dlg.className=z?'z':'';dlg.innerHTML='<div class="mp">'+h+'</div>';dlg.showModal()};

const card=i=>{const a=D.u.find(x=>x.id===i.uid),isUrl=i.e&&(i.e.startsWith('http://')||i.e.startsWith('https://')||i.e.startsWith('www.'));return `<article class="card">${i.img?`<button class="pw" data-act="zoom" aria-label="Ampliar foto"><img class="pic" src="${i.img}" alt="Foto da publicação"></button>`:''}<div class="cb"><h3>${E(i.t)}</h3><p>${E(i.x)}</p>${i.e?`<p class="mut">${isUrl?`Saiba mais em: <a href="${i.e}" target="_blank" rel="noopener" style="color:var(--pri);text-decoration:underline;cursor:pointer;word-break:break-all">${i.e}</a>`:`${E(i.e)}`}</p>`:''}<small class="mut">Por ${E(a?.nome||'morador')}, ${fd(i.w)}</small></div></article>`};
const hdr=(r,u)=>{$('#top').innerHTML=`<div class="w bar"><a class="brand" href="#/"><i class="lg"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-5.6 7-11a7 7 0 0 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></i><div><b>Conecta Santa Regina</b><span>O ponto de encontro do nosso bairro</span></div></a><div class="acc">${u?`<a href="#/minhas">Minhas publicações</a>${isAdm(u)?`<a href="#/admin">Admin${pend()?` (${pend()} pendentes)`:''}</a>`:''}<button class="b s" data-act="out">Sair</button>`:`<a class="b a" href="#/entrar">Entrar ou criar conta</a>`}</div></div><nav class="w" aria-label="Seções">${NAV.map(([k,n])=>`<a href="#/${k}"${k===r?' aria-current="page"':''}>${n}</a>`).join('')}</nav>`};

const home=()=>{const n=ok('novidades'),f=ok('feed');return `<section class="hero"><div class="w"><span class="bdg">Conecta Santa Regina</span><h1>Tudo o que o nosso bairro tem, em um só lugar</h1><p>O ponto de encontro digital de Santa Regina: comércio, delivery, saúde, empregos, novidades e as ações que a comunidade organiza junto.</p></div></section>
${n?`<section class="w"><div style="text-align:center;margin-bottom:20px"><h2 style="color:var(--pri);margin:0">📰 NOVIDADES</h2></div><div class="carousel-wrapper"><div class="carousel-image-side"><button style="width:100%;height:100%;padding:0;border:0;cursor:pointer;background:none" data-act="nopen"><img class="carousel-image" src="${n[ni%n.length].img}" alt=""></button><div class="carousel-dots">${n.map((_,i)=>`<button class="dot ${i===ni%n.length?'active':''}" data-act="ngoto" data-i="${i}" aria-label=""></button>`).join('')}</div></div><div class="carousel-info" data-act="nopen"><div><span class="category-tag">Obra</span><h3>${E(n[ni%n.length].t)}</h3><p>${E(n[ni%n.length].x)}</p>${n[ni%n.length].e?`<p class="mut" style="margin-top:8px;font-size:.85rem"><a href="${n[ni%n.length].e}" target="_blank" rel="noopener" style="color:var(--pri);text-decoration:underline;cursor:pointer" onclick="event.stopPropagation()">Saiba mais em: ${n[ni%n.length].e}</a></p>`:''}</div><small>${E(D.u.find(x=>x.id===n[ni%n.length].uid)?.nome||'morador')}, ${fd(n[ni%n.length].w)}</small></div><button class="carousel-nav prev" data-act="nnav" data-d="-1">‹</button><button class="carousel-nav next" data-act="nnav" data-d="1">›</button></div></section>`:''}
<section class="w"><div style="text-align:center;margin-bottom:32px"><span style="color:var(--pri);font-weight:600;font-size:.9rem">SANTA REGINA EM MOVIMENTO</span><h2 style="margin:8px 0">Feed da comunidade</h2></div><div style="max-width:720px;margin:0 auto"><div class="hd" style="margin-bottom:20px;justify-content:center"><button class="b" data-act="new" data-cat="feed">Quero compartilhar</button></div><div>${f.map(card).join('')||'<p class="mut" style="text-align:center">Ainda não há publicações aprovadas no feed.</p>'}</div></div></section>
<section class="w"><h2>O que você procura?</h2><div class="g">${Object.keys(C).filter(k=>k!=='feed').map(k=>`<a class="tile" href="#/${k}"><b>${C[k].t}</b><span>${C[k].d}</span></a>`).join('')}<a class="tile" href="#/contato"><b>Fale Conosco</b><span>Mande uma mensagem para a gente</span></a></div></section>
<section class="w cta"><h2>Tem algo para publicar?</h2><p>Cadastrar comércio, vagas e imóveis é gratuito. Para publicar no Feed e em Novidades é preciso ser Premium. Tudo passa pela aprovação da administração.</p><a class="b a" href="#/entrar">Cadastre-se</a></section>`};
const list=c=>{const k=C[c];return `<section class="w"><div class="hd"><div><h1>${k.t}</h1><p class="mut">${k.d}</p></div><button class="b" data-act="new" data-cat="${c}">${k.b}</button></div>${k.pr?'<p class="note">Publicar em Novidades é exclusivo para perfis Premium. Toda publicação passa pela aprovação da administração antes de aparecer.</p>':'<p class="note">Cadastrar é gratuito. Apenas o Feed e as Novidades são exclusivos para perfis Premium. Tudo o que for publicado ou cadastrado passa pela aprovação da administração antes de aparecer aqui.</p>'}<div class="g">${ok(c).map(card).join('')||'<p class="mut">Nada publicado ainda. Seja o primeiro!</p>'}</div></section>`};

const contact=()=>`<section class="w"><div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:start"><div><h1>Fale Conosco</h1><div style="background:var(--card);border:1px solid var(--ln);border-radius:14px;padding:20px;margin-bottom:20px"><h3 style="margin:0 0 12px;color:var(--pri)">Quer ser Premium?</h3><p style="margin:0 0 16px;font-size:.95rem;color:var(--mut)">Quer ser Premium ou tem alguma dúvida? Entre em contato conosco através dos canais abaixo:</p><div style="display:flex;gap:10px;flex-wrap:wrap"><a class="b a" target="_blank" rel="noopener" href="${wa('47992928049','Olá! Gostaria de saber mais sobre ser Premium no Conecta Santa Regina.')}">Nos chame no WhatsApp</a><a class="b s" target="_blank" rel="noopener" href="mailto:${ADMIN}?subject=Dúvida sobre Premium - Conecta Santa Regina&body=Olá!%20Gostaria%20de%20saber%20mais%20sobre%20ser%20Premium%20no%20Conecta%20Santa%20Regina.">Envie um e-mail</a></div></div></div><div style="background:var(--card);border:1px solid var(--ln);border-radius:14px;padding:20px"><h3 style="margin:0 0 12px;color:var(--pri)">Sobre o Conecta Santa Regina</h3><p style="margin:0 0 12px;font-size:.95rem;color:var(--mut);line-height:1.6"><strong>O que é?</strong> Um espaço digital feito por moradores, para moradores do bairro Santa Regina.</p><p style="margin:0 0 12px;font-size:.95rem;color:var(--mut);line-height:1.6"><strong>Para que serve?</strong> Conectar a comunidade, compartilhar informações sobre comércio, saúde, empregos, imóveis, novidades e ações solidárias do bairro.</p><h4 style="margin:12px 0 8px;color:var(--ink)">Perfil Grátis</h4><p style="margin:0 0 12px;font-size:.9rem;color:var(--mut)">✓ Qualquer morador pode usar<br>✓ Cadastrar comércios, serviços, vagas, imóveis, melhorias e doações<br>✓ Visualizar tudo que é publicado<br>✓ Sem custos</p><h4 style="margin:12px 0 8px;color:var(--ink)">Perfil Premium</h4><p style="margin:0 0 12px;font-size:.9rem;color:var(--mut)">✓ Para comerciantes e prestadores de serviços<br>✓ Publicar no Feed e Novidades<br>✓ Maior visibilidade<br>✓ Taxa mensal de R$ 25,00</p><p style="margin:0;font-size:.8rem;color:var(--mut);font-style:italic">Todas as publicações estarão sujeitas a aprovação do administrador.</p></div></div></section>`;
const mine=()=>{const u=me();if(!u)return '<section class="w"><p>Entre na sua conta para ver suas publicações.</p></section>';const l=D.i.filter(i=>i.uid===u.id).sort((a,b)=>b.w-a.w);return `<section class="w"><h1>Minhas publicações</h1><p class="mut">${isAdm(u)?'Administração.':prem(u)?'Premium ativo até '+fd(u.ate)+'.':u.ate?'Seu Premium venceu. Para renovar, toque em “Quero compartilhar”.':'Perfil grátis.'}</p><p class="note">Ao editar, a publicação volta para aprovação. Ao excluir, ela sai do ar na hora.</p>${l.map(i=>`<div class="row">${card(i)}<div class="rb"><span class="tag ${i.st}">${i.st==='p'?'Aguardando aprovação':'Publicado'}</span><span class="mut">${C[i.cat].t}</span><button class="b s" data-act="edit" data-id="${i.id}">Editar</button><button class="b d" data-act="del" data-id="${i.id}">Excluir</button></div></div>`).join('')||'<p class="mut">Você ainda não publicou nada.</p>'}</section>`};

const admin=()=>{let b='';
if(at==='ap'){b=D.r.filter(r=>r.st==='p').map(r=>`<div class="row2"><div><b>Pedido Premium: ${E(r.nome)}</b><br><span class="mut">${E(r.contato)}, ${r.m} mês(es)</span></div><a class="b s" target="_blank" rel="noopener" href="${wa(r.contato,`Olá, ${r.nome}! Recebemos seu pedido de Premium por ${r.m} mês(es). Segue a chave Pix para o pagamento: `)}">Chamar no WhatsApp</a><button class="b" data-act="ativ" data-id="${r.id}">Pagamento confirmado: ativar</button><button class="b d" data-act="rec" data-id="${r.id}">Recusar</button></div>`).join('')+D.i.filter(i=>i.st==='p').map(i=>`<div class="row2">${card(i)}<div class="rb"><span class="mut">${C[i.cat].t}</span><button class="b" data-act="apr" data-id="${i.id}">Aprovar</button><button class="b d" data-act="del" data-id="${i.id}">Recusar e excluir</button></div></div>`).join('');b=b||'<p class="mut">Nada para aprovar.</p>'}
if(at==='pf')b=`<div class="tw"><table><tr><th>Nome<th>E-mail<th>Contato<th>Plano<th>Ações</tr>${D.u.map(x=>`<tr><td>${E(x.nome)}${x.bl?' (bloqueado)':''}<td>${E(x.email)}<td><a target="_blank" rel="noopener" href="${wa(x.tel,'Olá, '+x.nome+'!')}">${E(x.tel)}</a><td>${isAdm(x)?'Admin':prem(x)?'Premium até '+fd(x.ate):'Grátis'}<td>${isAdm(x)?'':`<button class="b s" data-act="blk" data-id="${x.id}">${x.bl?'Desbloquear':'Bloquear'}</button>`}</tr>`).join('')}</table></div>`;
if(at==='ms')b=D.m.map(m=>`<div class="row2"><div><b>${E(m.nome)}</b> <a href="mailto:${E(m.email)}">${E(m.email)}</a><p>${E(m.x)}</p></div></div>`).join('')||'<p class="mut">Sem mensagens.</p>';
return `<section class="w"><h1>Painel da administração</h1><div class="tabs">${[['ap','Aprovações ('+pend()+')'],['pf','Perfis ('+D.u.length+')'],['ms','Mensagens']].map(([k,n])=>`<button data-act="at" data-t="${k}" aria-pressed="${at===k}">${n}</button>`).join('')}</div>${b}</section>`};

function view(){const r=location.hash.replace('#/',''),u=me();hdr(r,u);
$('#app').innerHTML=r==='contato'?contact():r==='entrar'?auth():r==='minhas'?mine():r==='admin'?(isAdm(u)?admin():'<section class="w"><p>Acesso restrito à administração.</p></section>'):C[r]&&r!=='feed'?list(r):home()}

const openPrem=()=>{const u=me();modal(`<h2>Para publicar, o perfil precisa ser Premium</h2><p>O Feed e as Novidades são exclusivos para perfis Premium, com mensalidade paga por Pix. Veja como fazer:</p><ol><li>Preencha o mini cadastro abaixo e escolha quantos meses quer.</li><li>Pague a taxa pelo Pix, usando o QR Code desta janela.</li><li>A administração chama você no WhatsApp, passa a chave Pix e confirma o pagamento.</li><li>Seu perfil vira Premium até a data informada. Cada publicação ainda passa pela aprovação da administração.</li></ol><div class="qr">${PIX_IMG?`<img src="${PIX_IMG}" alt="QR Code Pix">`:'QR Code Pix<br>(a imagem entra aqui)'}</div>${u?`<form data-f="prem"><label>Nome<input name="nome" required value="${E(u.nome)}"></label><label>WhatsApp ou outro contato<input name="contato" required value="${E(u.tel)}"></label><label>Meses de Premium<select name="m">${[1,2,3,6,12].map(n=>`<option>${n}</option>`).join('')}</select></label><button class="b">Enviar pedido de Premium</button> <button type="button" class="b s" data-act="x">Fechar</button></form>`:`<p><a class="b a" data-act="x" href="#/entrar">Entrar ou criar conta para pedir Premium</a></p>`}`)};

const openPost=(c,id)=>{const i=id&&D.i.find(a=>a.id===id)||{},a=isAdm(me());modal(`<h2>${id?'Editar publicação':C[c].b}</h2>${id&&!a?'<p class="note">Depois de salvar, a publicação volta para aprovação.</p>':''}<form data-f="post"><input type="hidden" name="cat" value="${c}"><input type="hidden" name="id" value="${id||''}"><label>Título<input name="t" required maxlength="90" value="${E(i.t)}"></label><label>Texto<textarea name="x" rows="4" required>${E(i.x)}</textarea></label>${c==='novidades'?`<label>Duração da publicação<select name="dias" required><option value="1">1 dia</option><option value="3">3 dias</option><option value="7">7 dias</option></select></label><label>Link (opcional)<input name="e" placeholder="https://exemplo.com" value="${E(i.e)}"></label>`:c==='feed'?`<label>Duração da publicação<select name="dias" required><option value="5">5 dias</option><option value="10">10 dias</option><option value="30">30 dias</option></select></label>`:`<label>${C[c].p}<input name="e" value="${E(i.e)}"></label>`}<label>Foto (opcional)<input type="file" name="img" accept="image/*"></label><button class="b">${a?'Publicar':id?'Salvar alterações':'Enviar para aprovação'}</button> <button type="button" class="b s" data-act="x">Cancelar</button></form>`)};

const updateCarousel=()=>{const n=ok('novidades');if(!n||!n.length)return;const idx=ni%n.length;const img=$('.carousel-image'),h3=$('.carousel-info h3'),p=$('.carousel-info p'),sm=$('.carousel-info small'),link=$('.carousel-info a'),dots=document.querySelectorAll('.dot');if(img)img.src=n[idx].img;if(h3)h3.textContent=E(n[idx].t);if(p)p.textContent=E(n[idx].x);if(link&&n[idx].e){link.href=n[idx].e;link.textContent='Saiba mais em: '+n[idx].e}if(sm)sm.textContent=E(D.u.find(x=>x.id===n[idx].uid)?.nome||'morador')+', '+fd(n[idx].w);dots.forEach((d,i)=>d.classList.toggle('active',i===idx))};const startAutoCarousel=()=>{const n=ok('novidades');if(!n||n.length<2)return;ni=(ni+1)%n.length;updateCarousel();window.autoCarousel=setTimeout(startAutoCarousel,5000)};addEventListener('hashchange',()=>{clearTimeout(window.autoCarousel);});view();

document.addEventListener('click',e=>{if(e.target===dlg)return dlg.close();const b=e.target.closest('[data-act]');if(!b)return;const{act,id,cat,t,d}=b.dataset,u=me();
const A={x:()=>dlg.close(),nopen:()=>{to('novidades')},eye:()=>{const i=b.previousElementSibling,s=i.type==='password';i.type=s?'text':'password';b.classList.toggle('on',s);b.setAttribute('aria-label',s?'Ocultar senha':'Mostrar senha')},
out:()=>{D.s=null;save();to('')},
new:()=>{if(C[cat].pr&&!prem(u))return openPrem();if(!u){toast('Entre ou crie sua conta para cadastrar.');return to('entrar')}openPost(cat)},
edit:()=>openPost(D.i.find(a=>a.id===id).cat,id),
zoom:()=>modal(`<img data-act="x" src="${b.querySelector('img').src}" alt="Foto ampliada"><button class="cl" data-act="x" aria-label="Fechar">×</button>`,1),
del:()=>{b.textContent='Confirmar exclusão';b.dataset.act='del2'},
del2:()=>{D.i=D.i.filter(a=>a.id!==id);save();view()},rep:()=>{const pub=D.i.find(a=>a.id===id);if(!pub)return;openPost(pub.cat,id)},
apr:()=>{D.i.find(a=>a.id===id).st='o';save();view()},
blk:()=>{const x=D.u.find(a=>a.id===id);x.bl=x.bl?0:1;save();view()},
rec:()=>{D.r.find(a=>a.id===id).st='n';save();view()},
ativ:()=>{const r=D.r.find(a=>a.id===id),x=D.u.find(a=>a.id===r.uid);x.ate=Math.max(Date.now(),x.ate||0)+r.m*30*864e5;r.st='o';save();view();toast('Premium ativo até '+fd(x.ate)+'. Avise a pessoa pelo WhatsApp.');window.open(wa(x.tel,`Olá, ${x.nome}! Pagamento confirmado: seu perfil Premium está ativo até ${fd(x.ate)}.`),'_blank','noopener')},
tab:()=>{tab=t;view()},at:()=>{at=t;view()},
nnav:()=>{clearTimeout(window.autoCarousel);const n=ok('novidades');if(!n||n.length<2)return;ni=(ni+ +d+n.length)%n.length;updateCarousel();window.autoCarousel=setTimeout(startAutoCarousel,5000)},
ngoto:()=>{clearTimeout(window.autoCarousel);ni=+id;updateCarousel();window.autoCarousel=setTimeout(startAutoCarousel,5000)},
sl:()=>{si=(si+ +d+SL.length)%SL.length;$('.car').innerHTML=slide()}};
A[act]?.()});

document.addEventListener('submit',async e=>{e.preventDefault();const F=e.target,f=F.dataset.f,v=Object.fromEntries(new FormData(F)),u=me();
if(f==='in'){const p=await hs(v.senha),x=D.u.find(a=>a.email===v.email.trim().toLowerCase()&&a.senha===p);if(!x)return toast('E-mail ou senha incorretos.');if(x.bl)return toast('Conta bloqueada. Fale com a administração.');D.s=x.id;save();return to('')}
if(f==='up'){const em=v.email.trim().toLowerCase();if(D.u.some(a=>a.email===em))return toast('Este e-mail já tem conta. Use a aba Entrar.');const x={id:uid(),nome:v.nome.trim(),email:em,tel:v.tel.trim(),senha:await hs(v.senha),role:em===ADMIN?'admin':'user',ate:0,bl:0};D.u.push(x);D.s=x.id;save();toast('Conta criada!');return to('')}
if(f==='post'){const img=await shrink(v.img),ad=isAdm(u),i=v.id&&D.i.find(a=>a.id===v.id),dias=(v.cat==='novidades'||v.cat==='feed')?+v.dias:0,exp=dias?Date.now()+dias*864e5:0;
if(i){Object.assign(i,{t:v.t,x:v.x,e:v.e,exp});if(img)i.img=img;i.st=ad?'o':'p'}else D.i.push({id:uid(),cat:v.cat,uid:u.id,t:v.t,x:v.x,e:v.e,img,w:Date.now(),exp,st:ad?'o':'p'});
save();dlg.close();toast(ad?'Publicado.':'Enviado! Aparece depois da aprovação da administração.');return view()}
if(f==='prem'){D.r.push({id:uid(),uid:u.id,nome:v.nome,contato:v.contato,m:+v.m,st:'p',w:Date.now()});save();dlg.close();toast('Pedido enviado! A administração vai chamar você no WhatsApp.');view()}
if(f==='msg'){D.m.push({nome:v.nome,email:v.email,x:v.x,w:Date.now()});save();const s=encodeURIComponent('Fale Conosco: '+v.nome),bd=encodeURIComponent(`Nome: ${v.nome}\nE-mail: ${v.email}\n\n${v.x}`);F.outerHTML=`<div class="box" role="status"><h2>Falta só um passo</h2><p>Sua mensagem está pronta. Para ela chegar até nós, envie pelo seu e-mail:</p><p><a class="b" target="_blank" rel="noopener" href="mailto:${ADMIN}?subject=${s}&amp;body=${bd}">Abrir no app de e-mail</a> <a class="b s" target="_blank" rel="noopener" href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=${ADMIN}&amp;su=${s}&amp;body=${bd}">Abrir no Gmail</a></p></div>`}});

addEventListener('hashchange',()=>{view();scrollTo(0,0)});view();
setTimeout(startAutoCarousel,5000);
</script>
</body>
</html>
